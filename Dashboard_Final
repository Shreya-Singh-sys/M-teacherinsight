<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TIE — Dashboard (single file)</title>

  <!-- Tailwind CDN for quick styling -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Chart.js for charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    /* small customizations */
    .card { background: white; border-radius: 12px; box-shadow: 0 6px 18px rgba(12, 18, 36, 0.06); }
    .metric-bar { height: 10px; background: #eef2ff; border-radius: 8px; overflow: hidden; }
    .metric-fill { height: 100%; background: #2563eb; border-radius: 8px; transition: width .5s ease; }
    .chat-bubble-user { background:#e0f2fe; color:#0f172a; padding:10px 12px; border-radius:10px; display:inline-block; max-width:70%; }
    .chat-bubble-ai { background:#f1f5f9; color:#0f172a; padding:10px 12px; border-radius:10px; display:inline-block; max-width:70%; }
    /* make layout scroll nicely on smaller screens */
    .feature-panel { min-width:280px; max-width:340px; }
  </style>
</head>
<body class="bg-gray-50 text-slate-800">

  <!-- Top nav -->
  <header class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-600 rounded-md flex items-center justify-center text-white font-bold">T</div>
        <div>
          <div class="text-xl font-semibold">TIE</div>
          <div class="text-xs text-slate-500">Teaching Insight & Evaluation</div>
        </div>
      </div>
      <div class="text-sm text-slate-600">Logout</div>
    </div>
  </header>

  <!-- Main layout -->
  <main class="max-w-7xl mx-auto px-6 py-8 flex gap-6">
    <!-- Main content -->
    <section class="flex-1 space-y-6">
      <!-- Upload form (left top) -->
      <div class="card p-5 grid grid-cols-3 gap-4">
        <div class="col-span-2">
          <h3 class="text-lg font-semibold mb-2">Upload Session (video required)</h3>
          <p class="text-sm text-slate-500 mb-3">Upload classroom session files for processing (video MP4, optional audio WAV and feedback JSON).</p>

          <form id="uploadForm" onsubmit="uploadSession(event)">
            <div class="grid grid-cols-2 gap-3">
              <input id="teacherId" class="border p-2 rounded" placeholder="Teacher ID" value="teacher_1" />
              <input id="sessionId" class="border p-2 rounded" placeholder="Session ID" value="session_{{Date.now()}}" />
            </div>

            <div class="grid grid-cols-3 gap-3 mt-3">
              <input id="videoFile" type="file" accept="video/*" class="col-span-1" />
              <input id="audioFile" type="file" accept="audio/*" class="col-span-1" />
              <input id="feedbackFile" type="file" accept="application/json" class="col-span-1" />
            </div>

            <div class="mt-3 flex items-center gap-3">
              <button class="bg-blue-600 text-white px-4 py-2 rounded" type="submit">Upload & Process</button>
              <div id="uploadStatus" class="text-sm text-slate-500"></div>
            </div>
          </form>
        </div>

        <div class="border-l pl-4">
          <div class="text-sm text-slate-500 mb-2">Quick actions</div>
          <button onclick="fetchAggregate()" class="w-full bg-slate-100 p-2 rounded mb-2 text-sm">Refresh Aggregates</button>
          <button onclick="loadRecent()" class="w-full bg-slate-100 p-2 rounded mb-2 text-sm">Load Recent Sessions</button>
          <div class="text-xs text-slate-400 mt-2">Note: to use upload/chat with a real backend run the FastAPI server at <code>http://localhost:8080</code>.</div>
        </div>
      </div>

      <!-- Aggregate chart + scorecards -->
      <div class="card p-6 grid grid-cols-3 gap-6 items-center">
        <div class="col-span-2">
  <h3 class="text-lg font-semibold mb-4">Aggregate Metrics</h3>

  <!-- FIX: give the chart a fixed height container -->
  <div style="height:260px;">
    <canvas id="aggregateChart"></canvas>
  </div>
</div>

        <div class="border-l pl-6 space-y-4">
          <div>
            <div class="text-sm text-slate-500">Clarity</div>
            <div class="text-3xl font-extrabold" id="scoreClarity">72</div>
          </div>
          <div>
            <div class="text-sm text-slate-500">Engagement</div>
            <div class="text-3xl font-extrabold" id="scoreEngagement">65</div>
          </div>
          <div>
            <div class="text-sm text-slate-500">Delivery</div>
            <div class="text-3xl font-extrabold" id="scoreDelivery">79</div>
          </div>
          <div>
            <div class="text-sm text-slate-500">Fairness</div>
            <div class="text-3xl font-extrabold" id="scoreFairness">86</div>
          </div>
        </div>
      </div>

      <!-- Improvement suggestions + Recent sessions + Chat -->
      <div class="grid grid-cols-3 gap-6">
        <!-- Improvements + Recent -->
        <div class="col-span-2 space-y-4">
          <div class="card p-6">
            <h3 class="text-lg font-semibold mb-4">Improvement Suggestions</h3>
            <div class="grid grid-cols-3 gap-4">
              <div class="p-4 bg-slate-50 rounded">
                <h4 class="font-semibold mb-2">Clarity</h4>
                <ul class="text-sm text-slate-600 list-disc ml-5">
                  <li>Maintain steady pace (130–150 WPM)</li>
                  <li>Use concise sentences</li>
                </ul>
              </div>
              <div class="p-4 bg-slate-50 rounded">
                <h4 class="font-semibold mb-2">Engagement</h4>
                <ul class="text-sm text-slate-600 list-disc ml-5">
                  <li>Ask short interactive questions</li>
                  <li>Use gestures & eye contact</li>
                </ul>
              </div>
              <div class="p-4 bg-slate-50 rounded">
                <h4 class="font-semibold mb-2">Delivery</h4>
                <ul class="text-sm text-slate-600 list-disc ml-5">
                  <li>Vary tone and emphasize transitions</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <h3 class="text-lg font-semibold mb-4">Recent Sessions</h3>
            <table class="w-full text-left text-sm">
              <thead class="text-slate-500">
                <tr><th class="py-2">Session ID</th><th class="py-2">Date</th><th class="py-2">Summary</th><th class="py-2">Action</th></tr>
              </thead>
              <tbody id="recentTableBody">
                <!-- filled by loadRecent() -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Chat Agent -->
        <aside class="card p-6">
          <h3 class="text-lg font-semibold mb-4">Chat Agent</h3>

          <div id="chatWindow" class="h-80 overflow-y-auto p-2 bg-slate-50 rounded mb-3">
            <!-- messages appended here -->
            <div class="chat-bubble-ai mb-2">Hi — ask me about clarity, engagement or delivery. Example: "How to improve engagement?"</div>
          </div>

          <div class="flex gap-2">
            <input id="chatInput" class="flex-1 border rounded px-3 py-2" placeholder="Type your question..." />
            <button id="chatSendBtn" class="bg-blue-600 text-white px-4 py-2 rounded" onclick="sendChat()">Send</button>
          </div>
        </aside>
      </div>
    </section>

    <!-- Feature Insights side panel (fixed column) -->
    <aside class="feature-panel card p-5 sticky top-6 h-[calc(100vh-120px)] overflow-y-auto">
      <h3 class="text-lg font-semibold mb-4">Feature Insights</h3>

      <div>
        <h4 class="text-sm font-medium text-slate-600 mb-2">Audio Features</h4>
        <FeatureMetric name="Clarity" id="f_clarity" value="88" />
        <FeatureMetric name="Pitch variance" id="f_pitch" value="15" />
        <FeatureMetric name="Pace" id="f_pace" value="72" />
        <FeatureMetric name="Articulation" id="f_artic" value="80" />
      </div>

      <hr class="my-4" />

      <div>
        <h4 class="text-sm font-medium text-slate-600 mb-2">Facial Features</h4>
        <FeatureMetric name="Smile intensity" id="f_smile" value="95" />
        <FeatureMetric name="Eye contact ratio" id="f_eye" value="80" />
        <FeatureMetric name="Emotion stability" id="f_emo" value="75" />
      </div>

      <hr class="my-4" />

      <div>
        <h4 class="text-sm font-medium text-slate-600 mb-2">Body Posture</h4>
        <FeatureMetric name="Gesture amplitude" id="f_gest" value="82" />
        <FeatureMetric name="Posture confidence" id="f_post" value="78" />
        <FeatureMetric name="Movement energy" id="f_move" value="74" />
      </div>

      <hr class="my-4" />

      <div>
        <h4 class="text-sm font-medium text-slate-600 mb-2">Feedback NLP</h4>
        <FeatureMetric name="Sentiment score" id="f_sent" value="85" />
        <FeatureMetric name="Clarity mentions" id="f_clarm" value="50" />
        <FeatureMetric name="Engagement tags" id="f_tags" value="78" />
      </div>

      <div class="mt-4 text-xs text-slate-400">
        Feature values are shown as percentages (0–100). When connected to backend, these update from real session data.
      </div>
    </aside>
  </main>

  <!-- Templates & small helpers -->
  <template id="featureMetricTpl">
    <div class="mb-4">
      <div class="flex justify-between items-center text-sm text-slate-700 mb-1">
        <div class="font-medium name"></div>
        <div class="text-sm value"></div>
      </div>
      <div class="metric-bar">
        <div class="metric-fill" style="width:0%"></div>
      </div>
    </div>
  </template>

  <script>
    /* ----------------------
       Helper: FeatureMetric
       ---------------------- */
    function FeatureMetric(name,id,value){
      const tpl = document.getElementById('featureMetricTpl').content.cloneNode(true);
      tpl.querySelector('.name').textContent = name;
      tpl.querySelector('.value').textContent = value + '%';
      tpl.querySelector('.metric-fill').style.width = Math.max(2, value) + '%';
      const container = document.getElementById(id);
      if(container){
        // if element exists, replace contents, else append to side panel by id mapping
      }
      // we instead will find the placeholder nodes created in HTML via custom tags
    }

    // Create placeholders in the sidebar (we used custom markup via the FeatureMetric function call above in HTML)
    // Instead of actual component calls, let's populate by id after DOM loaded
    document.addEventListener('DOMContentLoaded', () => {
      const sideMetrics = [
        {id:'f_clarity', name:'Clarity', value:88},
        {id:'f_pitch', name:'Pitch variance', value:15},
        {id:'f_pace', name:'Pace', value:72},
        {id:'f_artic', name:'Articulation', value:80},
        {id:'f_smile', name:'Smile intensity', value:95},
        {id:'f_eye', name:'Eye contact ratio', value:80},
        {id:'f_emo', name:'Emotion stability', value:75},
        {id:'f_gest', name:'Gesture amplitude', value:82},
        {id:'f_post', name:'Posture confidence', value:78},
        {id:'f_move', name:'Movement energy', value:74},
        {id:'f_sent', name:'Sentiment score', value:85},
        {id:'f_clarm', name:'Clarity mentions', value:50},
        {id:'f_tags', name:'Engagement tags', value:78},
      ];

      const panel = document.querySelector('.feature-panel');
      // Clear default (we already wrote static structure in HTML); instead update bars by searching nodes with matching captions
      // We'll create dynamic metric blocks instead of trying to find placeholder ids.
      panel.innerHTML = '<h3 class=\"text-lg font-semibold mb-4\">Feature Insights</h3>';
      sideMetrics.forEach(m=>{
        const el = document.getElementById('featureMetricTpl').content.cloneNode(true);
        el.querySelector('.name').textContent = m.name;
        el.querySelector('.value').textContent = m.value + '%';
        el.querySelector('.metric-fill').style.width = Math.max(2, m.value) + '%';
        panel.appendChild(el);
      });

      // init chart and fetch initial aggregates
      initChart();
      fetchAggregate();
      loadRecent();
    });

    /* ----------------------
       Aggregate Chart Setup
       ---------------------- */
    function initChart() {
  const ctx = document.getElementById('aggregateChart').getContext('2d');

  aggregateChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: ["Sep 3","Sep 5","Sep 10","Sep 13","Sep 16","Sep 21","Sep 23"],
      datasets: [
        {
          label:'Clarity',
          data:[80,78,82,79,81,85,83],
          borderColor:'#2563eb',
          tension:0.4,
          fill:true,
          backgroundColor:'rgba(37,99,235,0.06)'
        },
        {
          label:'Engagement',
          data:[65,63,66,64,67,68,66],
          borderColor:'#10b981',
          tension:0.4,
          fill:false
        },
        {
          label:'Delivery',
          data:[45,47,46,48,49,50,47],
          borderColor:'#f59e0b',
          tension:0.4,
          fill:false
        }
      ]
    },
    options: {
      animation: false,     // prevent looping animations
      responsive: true,
      plugins: { legend:{ position:'bottom' } },
      scales: { y:{ min:20, max:100 } },
      maintainAspectRatio: false
    }
  });
}


    /* ----------------------
       Backend endpoints (adjust if your backend runs elsewhere)
       ---------------------- */
    const BACKEND_BASE = window.BACKEND_BASE || 'http://localhost:8080';

    /* ----------------------
       Fetch aggregate metrics from backend
       Endpoint expected: GET /api/v1/metrics/aggregate
       ---------------------- */
    async function fetchAggregate(){
      try {
        const res = await fetch(`${BACKEND_BASE}/api/v1/metrics/aggregate`);
        if (!res.ok) throw new Error('No backend');
        const j = await res.json();
        // update top scores
        document.getElementById('scoreClarity').textContent = Math.round(j.mean_clarity || 0);
        document.getElementById('scoreEngagement').textContent = Math.round(j.mean_engagement || 0);
        document.getElementById('scoreDelivery').textContent = Math.round(j.mean_delivery || 0);
        document.getElementById('scoreFairness').textContent = Math.round(j.fairness_index || 0);

        // update recent sessions list
        const recent = j.recent_sessions || [];
        populateRecentTable(recent);

        // optional: update chart (here we will not overwrite series length mismatch; this is a demo)
      } catch (err) {
        console.warn('Aggregate: using mock data (backend not reachable).', err);
        // leave default UI values / or use mocks
      }
    }

    /* ----------------------
       Load recent sessions (GET /api/v1/sessions/recent)
       ---------------------- */
    async function loadRecent(){
      try {
        const res = await fetch(`${BACKEND_BASE}/api/v1/sessions/recent`);
        if (!res.ok) throw new Error('no recent endpoint');
        const j = await res.json();
        const sessions = j.sessions || [];
        populateRecentTable(sessions);
      } catch (err) {
        console.warn('Recent sessions: backend not reachable; using mocked data.');
        const mock = [
          { session_id: 'abc123', teacher_id:'Miriam Garcia', timestamp: new Date().toISOString(), scores:{clarity:88, engagement:72} },
          { session_id: 'abc122', teacher_id:'Timothy Smith', timestamp: new Date().toISOString(), scores:{clarity:90, engagement:75} }
        ];
        populateRecentTable(mock);
      }
    }

    function populateRecentTable(sessions){
      const body = document.getElementById('recentTableBody');
      body.innerHTML = '';
      sessions.forEach(s=>{
        const tr = document.createElement('tr');
        tr.className = 'border-b';
        tr.innerHTML = `
          <td class="py-3">${s.session_id || s.sessionId || s.session_id}</td>
          <td class="py-3">${(s.timestamp? new Date(s.timestamp): new Date()).toLocaleString()}</td>
          <td class="py-3">${(s.scores && s.scores.clarity) ? 'clarity:'+Math.round(s.scores.clarity) : '—' }</td>
          <td class="py-3"><button class="text-blue-600 text-sm" onclick="loadSession('${s.session_id || s.sessionId || s.session_id}')">Open</button></td>
        `;
        body.appendChild(tr);
      });
    }

    /* ----------------------
       Load a session (GET /api/v1/session/{id})
       When loaded, update the feature panel and timeline (if available)
       ---------------------- */
    async function loadSession(sessionId){
      try {
        const res = await fetch(`${BACKEND_BASE}/api/v1/session/${sessionId}`);
        if (!res.ok) throw new Error('session not found');
        const j = await res.json();
        const data = j.results || j;
        // update scores
        if (data.session_scores) {
          document.getElementById('scoreClarity').textContent = Math.round(data.session_scores.clarity || 0);
          document.getElementById('scoreEngagement').textContent = Math.round(data.session_scores.engagement || 0);
          document.getElementById('scoreDelivery').textContent = Math.round(data.session_scores.delivery || 0);
        }
        // update feature panel if timeline contains embeddings with derived metrics (demo)
        if (data.timeline && data.timeline.length) {
          // Example: derive audio clarity mean -> update a sidebar metric
          const clarityVals = data.timeline.map(t=>t.clarity||0);
          const meanClarity = Math.round(clarityVals.reduce((a,b)=>a+b,0)/clarityVals.length);
          // update first metric block to meanClarity
          const fills = document.querySelectorAll('.metric-fill');
          if (fills && fills.length) {
            fills[0].style.width = Math.max(2, meanClarity) + '%';
            fills[0].closest('.mb-4').querySelector('.value').textContent = meanClarity + '%';
          }
        }
        alert('Session loaded: ' + sessionId);
      } catch (err) {
        alert('Could not load session: ' + err.message);
      }
    }

    /* ----------------------
       Upload Session (POST /api/v1/upload-session)
       form fields: teacher_id, session_id, video (required), audio (optional), feedback (optional)
       ---------------------- */
    async function uploadSession(e){
      e.preventDefault();
      const teacherId = document.getElementById('teacherId').value.trim();
      const sessionId = document.getElementById('sessionId').value.trim();
      const video = document.getElementById('videoFile').files[0];
      const audio = document.getElementById('audioFile').files[0];
      const feedback = document.getElementById('feedbackFile').files[0];
      const status = document.getElementById('uploadStatus');
      if (!teacherId || !sessionId || !video) { alert('Teacher ID, Session ID and video file required'); return; }

      const form = new FormData();
      form.append('teacher_id', teacherId);
      form.append('session_id', sessionId);
      form.append('video', video);
      if (audio) form.append('audio', audio);
      if (feedback) form.append('feedback', feedback);

      try {
        status.textContent = 'Uploading...';
        const resp = await fetch(`${BACKEND_BASE}/api/v1/upload-session`, { method:'POST', body: form });
        if (!resp.ok) {
          const text = await resp.text();
          throw new Error(text || 'upload failed');
        }
        const j = await resp.json();
        status.textContent = 'Uploaded. Processing finished (saved to ' + (j.results_path || j.resultsPath || 'server') + ')';
        // refresh lists
        fetchAggregate();
        loadRecent();
      } catch (err) {
        status.textContent = 'Upload error: ' + err.message;
      } finally {
        setTimeout(()=> status.textContent = '', 8000);
      }
    }

    /* ----------------------
       Chat: POST /api/v1/chat { message, teacher_id? }
       If backend is unreachable, we return a mocked reply
       ---------------------- */
    async function sendChat(){
      const input = document.getElementById('chatInput');
      const txt = input.value.trim();
      if (!txt) return;
      appendChat('user', txt);
      input.value = '';
      appendChat('ai', '...');

      try {
        const res = await fetch(`${BACKEND_BASE}/api/v1/chat`, {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ message: txt })
        });
        if (!res.ok) throw new Error('chat backend not available');
        const j = await res.json();
        replaceLastAI(j.response || j.reply || 'No reply');
      } catch (err) {
        // fallback mock reply
        replaceLastAI('Mock reply: Try varying tone, add short questions, and use gestures to improve student engagement.');
      }
    }

    function appendChat(sender, text){
      const win = document.getElementById('chatWindow');
      const div = document.createElement('div');
      div.className = sender === 'user' ? 'flex justify-end mb-2' : 'flex justify-start mb-2';
      const bubble = document.createElement('div');
      bubble.className = sender === 'user' ? 'chat-bubble-user' : 'chat-bubble-ai';
      bubble.textContent = text;
      div.appendChild(bubble);
      win.appendChild(div);
      win.scrollTop = win.scrollHeight;
    }

    function replaceLastAI(text){
      const win = document.getElementById('chatWindow');
      // find last AI bubble (class chat-bubble-ai). We'll replace the last one.
      const aiBubbles = win.querySelectorAll('.chat-bubble-ai');
      if (aiBubbles.length) {
        aiBubbles[aiBubbles.length - 1].textContent = text;
      } else {
        appendChat('ai', text);
      }
      win.scrollTop = win.scrollHeight;
    }

    /* ----------------------
       Small UX: bind Enter key to chat
       ---------------------- */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && document.activeElement === document.getElementById('chatInput')) {
        e.preventDefault();
        sendChat();
      }
    });
  </script>
</body>
</html>
